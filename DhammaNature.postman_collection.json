{
  "info": {
    "_postman_id": "dhammanature-api-collection",
    "name": "DhammaNature REST API",
    "description": "REST endpoints for Gallery and Products modules.\n\nStart the Spring Boot app (server.port=3069) before running requests.\nSet `baseUrl` to match your configured port.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gallery",
      "description": "CRUD + image endpoints for the Gallery module.",
      "item": [
        {
          "name": "Get All Gallery Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gallery",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gallery"]
            }
          },
          "response": []
        },
        {
          "name": "Get Gallery Item by Valid ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gallery/{{galleryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gallery", "{{galleryId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get Gallery Item by Invalid ID (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/gallery/99999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gallery", "99999"]
            }
          },
          "response": []
        },
        {
          "name": "Create Gallery Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.id) {",
                  "    pm.collectionVariables.set('galleryId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test Gallery Item\",\n  \"description\": \"A gallery item created via Postman.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/gallery",
              "host": ["{{baseUrl}}"],
              "path": ["api", "gallery"]
            }
          },
          "response": []
        },
        {
          "name": "Get Gallery Image by Valid ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gallery/{{galleryId}}/image",
              "host": ["{{baseUrl}}"],
              "path": ["gallery", "{{galleryId}}", "image"]
            }
          },
          "response": []
        },
        {
          "name": "Get Gallery Image by Invalid ID (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/gallery/99999/image",
              "host": ["{{baseUrl}}"],
              "path": ["gallery", "99999", "image"]
            }
          },
          "response": []
        }
      ]
    },
